<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:orientation="vertical">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="140dp" android:padding="18dp" android:gravity="center_vertical" android:background="@drawable/server_card" android:orientation="horizontal">
    <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/B_ToggleServer" android:layout_width="88dp" android:layout_height="88dp" android:background="@drawable/power_gradient" android:padding="26dp" android:contentDescription="@string/toggle_server" app:srcCompat="@drawable/line_power" app:tint="#111328" />
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:orientation="vertical">
      <TextView android:id="@+id/TV_ServerStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/status_off" android:textColor="@color/ui_red" android:textSize="12sp" android:textStyle="bold" />
      <TextView android:id="@+id/TV_ServerTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/start_sharing" android:textSize="20sp" android:textColor="@color/ui_text" android:textStyle="bold" />
      <TextView android:id="@+id/TV_ServerHint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/pick_items_hint" android:textSize="13sp" android:textColor="@color/ui_muted" />
    </LinearLayout>
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false" android:layout_marginTop="12dp">
    <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginHorizontal="3dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="110dp" android:orientation="vertical" android:gravity="center" android:paddingVertical="12dp" android:background="@drawable/glass_card" android:id="@+id/B_AddItems" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:contentDescription="@string/add_apps">
        <androidx.appcompat.widget.AppCompatImageButton android:layout_width="50dp" android:layout_height="50dp" android:background="@drawable/glass_card" android:backgroundTint="@color/ui_active" android:padding="13dp" app:srcCompat="@drawable/line_apps" app:tint="@color/ui_cyan" android:importantForAccessibility="no" android:clickable="false" android:focusable="false" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:paddingHorizontal="2dp" android:text="@string/add_apps" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/ui_text" android:labelFor="@id/B_AddItems" />
      </LinearLayout>
    </FrameLayout>
    <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginHorizontal="3dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="110dp" android:orientation="vertical" android:gravity="center" android:paddingVertical="12dp" android:background="@drawable/glass_card" android:id="@+id/B_AddFiles" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:contentDescription="@string/add_files">
        <androidx.appcompat.widget.AppCompatImageButton android:layout_width="50dp" android:layout_height="50dp" android:background="@drawable/glass_card" android:backgroundTint="@color/ui_active" android:padding="13dp" app:srcCompat="@drawable/line_file" app:tint="@color/ui_red" android:importantForAccessibility="no" android:clickable="false" android:focusable="false" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:paddingHorizontal="2dp" android:text="@string/add_files" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/ui_text" android:labelFor="@id/B_AddFiles" />
      </LinearLayout>
    </FrameLayout>
    <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginHorizontal="3dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="110dp" android:orientation="vertical" android:gravity="center" android:paddingVertical="12dp" android:background="@drawable/glass_card" android:id="@+id/B_Messages" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:contentDescription="@string/messages">
        <androidx.appcompat.widget.AppCompatImageButton android:layout_width="50dp" android:layout_height="50dp" android:background="@drawable/glass_card" android:backgroundTint="@color/ui_active" android:padding="13dp" app:srcCompat="@drawable/line_message" app:tint="@color/ui_teal" android:importantForAccessibility="no" android:clickable="false" android:focusable="false" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:paddingHorizontal="2dp" android:text="@string/messages" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/ui_text" android:labelFor="@id/B_Messages" />
      </LinearLayout>
      <TextView android:id="@+id/TV_NumberMessages" android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="top|end" android:background="@drawable/rounded_text_background" android:backgroundTint="@color/ui_badge" android:gravity="center" android:textColor="#FFFFFF" android:textSize="11sp" android:visibility="gone" />
    </FrameLayout>
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false" android:layout_marginTop="12dp">
    <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginHorizontal="3dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="110dp" android:orientation="vertical" android:gravity="center" android:paddingVertical="12dp" android:background="@drawable/glass_card" android:id="@+id/B_ShowAddress" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:contentDescription="@string/link">
        <androidx.appcompat.widget.AppCompatImageButton android:layout_width="50dp" android:layout_height="50dp" android:background="@drawable/glass_card" android:backgroundTint="@color/ui_active" android:padding="13dp" app:srcCompat="@drawable/line_link" app:tint="@color/ui_violet" android:importantForAccessibility="no" android:clickable="false" android:focusable="false" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:paddingHorizontal="2dp" android:text="@string/link" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/ui_text" android:labelFor="@id/B_ShowAddress" />
      </LinearLayout>
    </FrameLayout>
    <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginHorizontal="3dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="110dp" android:orientation="vertical" android:gravity="center" android:paddingVertical="12dp" android:background="@drawable/glass_card" android:id="@+id/B_ShowUsers" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:contentDescription="@string/users">
        <androidx.appcompat.widget.AppCompatImageButton android:layout_width="50dp" android:layout_height="50dp" android:background="@drawable/glass_card" android:backgroundTint="@color/ui_active" android:padding="13dp" app:srcCompat="@drawable/line_user" app:tint="@color/ui_gold" android:importantForAccessibility="no" android:clickable="false" android:focusable="false" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:paddingHorizontal="2dp" android:text="@string/users" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/ui_text" android:labelFor="@id/B_ShowUsers" />
      </LinearLayout>
      <TextView android:id="@+id/TV_NumberUsers" android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="top|end" android:background="@drawable/rounded_text_background" android:backgroundTint="@color/ui_badge" android:gravity="center" android:textColor="#FFFFFF" android:textSize="11sp" android:visibility="gone" />
    </FrameLayout>
    <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginHorizontal="3dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="110dp" android:orientation="vertical" android:gravity="center" android:paddingVertical="12dp" android:background="@drawable/glass_card" android:id="@+id/B_ShowSelected" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:contentDescription="@string/selected">
        <androidx.appcompat.widget.AppCompatImageButton android:layout_width="50dp" android:layout_height="50dp" android:background="@drawable/glass_card" android:backgroundTint="@color/ui_active" android:padding="13dp" app:srcCompat="@drawable/line_selected" app:tint="@color/ui_green" android:importantForAccessibility="no" android:clickable="false" android:focusable="false" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:paddingHorizontal="2dp" android:text="@string/selected" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/ui_text" android:labelFor="@id/B_ShowSelected" />
      </LinearLayout>
      <TextView android:id="@+id/TV_NumberSelected" android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="top|end" android:background="@drawable/rounded_text_background" android:backgroundTint="@color/ui_badge" android:gravity="center" android:textColor="#FFFFFF" android:textSize="11sp" android:visibility="gone" />
    </FrameLayout>
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="end" android:layout_marginTop="12dp" android:visibility="gone">
    <Button android:id="@+id/B_Stream" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/streaming" android:textColor="@color/ui_muted" android:background="?attr/selectableItemBackgroundBorderless" />
    <Button android:id="@+id/B_ViewCert" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/view_https_certificate" android:textColor="@color/ui_muted" android:background="?attr/selectableItemBackgroundBorderless" />
  </LinearLayout>
</LinearLayout>
